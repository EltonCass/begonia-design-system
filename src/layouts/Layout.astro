---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description?: string;
  /** "light" pages use the sheet color for the whole body; the cover stays dark. */
  tone?: 'light' | 'dark';
}

const {
  title,
  description = 'Begonia style guide: color, typography, spacing, brand, shadows, borders, layouts, iconography and how to use it.',
  tone = 'light',
} = Astro.props;
const fullTitle = title === 'Begonia' ? 'Begonia Style Guide' : `${title} · Begonia`;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} sizes="32x32" />
    <ClientRouter />
  </head>
  <body class={tone}>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <!-- main is the scroll container, so the scrollbar sits below the header. -->
    <main id="main" tabindex="0" transition:name="main">
      <span id="copy-hint" class="visually-hidden">Press Enter to copy its CSS to the clipboard.</span>
      <slot />
    </main>
    <div id="toast" class="visually-hidden" role="status" aria-live="polite" transition:persist></div>
  </body>
</html>

<script>
  let direction = 'forward';

  // Direction of a page change follows the tab order: a tab further along slides in from the right.
  document.addEventListener('astro:before-preparation', (event) => {
    const paths = [...document.querySelectorAll<HTMLAnchorElement>('#site-nav a')].map((a) => new URL(a.href).pathname);
    const from = paths.indexOf(event.from.pathname);
    const to = paths.indexOf(event.to.pathname);
    direction = to >= from ? 'forward' : 'back';
    document.documentElement.dataset.dir = direction;
  });

  // Astro resets the <html> attributes when it swaps pages, and the animation runs after that.
  document.addEventListener('astro:after-swap', () => {
    document.documentElement.dataset.dir = direction;
  });

  // Copy buttons keep their visible text as the name and get the how-to as a description.
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-copy]').forEach((el) => {
      const target = el.tagName === 'TR' ? el.querySelector('button') : el;
      target?.setAttribute('aria-describedby', 'copy-hint');
    });
  });

  let announceTimer: number | undefined;

  async function copy(el: HTMLElement) {
    const text = el.dataset.copy ?? '';
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      const area = document.createElement('textarea');
      area.value = text;
      area.style.position = 'fixed';
      area.style.opacity = '0';
      document.body.append(area);
      area.select();
      document.execCommand('copy');
      area.remove();
    }

    // A translucent "Copied" overlay fades in over the card, then out.
    el.querySelector(':scope > .copy-overlay')?.remove();
    const overlay = document.createElement('span');
    overlay.className = 'copy-overlay';
    overlay.setAttribute('aria-hidden', 'true');
    const inner = document.createElement('span');
    const icon = document.createElement('i');
    icon.className = 'ph-duotone ph-check-circle';
    inner.append(icon);
    // Small targets (icons, logos) only have room for the check mark.
    if (el.offsetWidth >= 84) inner.append(' Copied');
    overlay.append(inner);
    el.append(overlay);
    overlay.addEventListener('animationend', () => overlay.remove());

    // Screen readers hear it through the live region.
    const live = document.getElementById('toast');
    if (live) {
      live.textContent = `Copied ${text.split('\n')[0]}`;
      window.clearTimeout(announceTimer);
      announceTimer = window.setTimeout(() => (live.textContent = ''), 2500);
    }
  }

  document.addEventListener('click', (event) => {
    const el = (event.target as HTMLElement).closest<HTMLElement>('[data-copy]');
    if (el) void copy(el);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Enter' && event.key !== ' ') return;
    const el = event.target as HTMLElement;
    // Native buttons already fire click on Enter and Space.
    if (el.dataset?.copy && el.tagName !== 'BUTTON') {
      event.preventDefault();
      void copy(el);
    }
  });
</script>

<style is:global>
  .skip {
    position: absolute;
    left: var(--space-4);
    top: -100px;
    z-index: 100;
    padding: var(--space-2) var(--space-4);
    background: var(--surface-header);
    color: var(--text);
    border-radius: var(--radius-sm);
  }
  .skip:focus { top: var(--space-2); }

  .canvas { padding-bottom: var(--space-12); }
</style>

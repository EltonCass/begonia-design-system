---
// A small CodePen-style viewer: Preview, HTML and CSS tabs, plus a button that opens the same code in CodePen.
interface Props {
  /** Unique id prefix for the tab/panel ids. */
  id: string;
  title: string;
  html: string;
  css: string;
}
const { id, title, html, css } = Astro.props;

const panes = [
  { key: 'preview', label: 'Preview' },
  { key: 'html', label: 'HTML' },
  { key: 'css', label: 'CSS' },
] as const;

// CodePen's prefill API: POST a JSON "data" field to /pen/define.
const codepen = JSON.stringify({ title, html, css, editors: '110', layout: 'left' });
---

<div class="codeview" data-codeview>
  <div class="bar">
    <div class="tabs" role="tablist" aria-label={`${title}: view as`}>
      {
        panes.map((p, i) => (
          <button
            type="button"
            role="tab"
            class="tab"
            id={`${id}-tab-${p.key}`}
            aria-controls={`${id}-panel-${p.key}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
          >
            {p.label}
          </button>
        ))
      }
    </div>
    <form action="https://codepen.io/pen/define" method="POST" target="_blank">
      <input type="hidden" name="data" value={codepen} />
      <button type="submit" class="pen">
        Edit on CodePen<i class="ph-duotone ph-arrow-up-right" aria-hidden="true"></i>
        <span class="visually-hidden">(opens in a new tab)</span>
      </button>
    </form>
  </div>

  <div class="panel preview" role="tabpanel" id={`${id}-panel-preview`} aria-labelledby={`${id}-tab-preview`}>
    <slot />
  </div>

  {
    [
      { key: 'html', label: 'HTML', code: html },
      { key: 'css', label: 'CSS', code: css },
    ].map((p) => (
      <div class="panel code" role="tabpanel" id={`${id}-panel-${p.key}`} aria-labelledby={`${id}-tab-${p.key}`} hidden>
        <button type="button" class="copy-btn copyable" data-copy={p.code}>
          <i class="ph-duotone ph-copy" aria-hidden="true" />
          Copy<span class="visually-hidden"> {p.label}</span>
        </button>
        <pre tabindex="0"><code>{p.code}</code></pre>
      </div>
    ))
  }
</div>

<script>
  function init() {
    document.querySelectorAll<HTMLElement>('[data-codeview]').forEach((root) => {
      if (root.dataset.bound) return;
      root.dataset.bound = 'true';
      const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];

      const select = (tab: HTMLButtonElement, focus = false) => {
        tabs.forEach((t) => {
          const on = t === tab;
          t.setAttribute('aria-selected', String(on));
          t.tabIndex = on ? 0 : -1;
          const panel = document.getElementById(t.getAttribute('aria-controls')!);
          if (panel) panel.hidden = !on;
        });
        if (focus) tab.focus();
      };

      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => select(tab));
        tab.addEventListener('keydown', (event) => {
          const last = tabs.length - 1;
          const next =
            event.key === 'ArrowRight' ? tabs[i === last ? 0 : i + 1] :
            event.key === 'ArrowLeft' ? tabs[i === 0 ? last : i - 1] :
            event.key === 'Home' ? tabs[0] :
            event.key === 'End' ? tabs[last] : null;
          if (next) {
            event.preventDefault();
            select(next, true);
          }
        });
      });
    });
  }
  init();
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .codeview { border: 1px solid var(--black-30); border-radius: 8px; overflow: hidden; background: var(--white-10); min-width: 0; }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-2) 0 var(--space-2);
    background: var(--black-40);
  }
  .tabs { display: flex; gap: 2px; }
  .tab {
    padding: var(--space-3) var(--space-4);
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    color: var(--gray-30);
    background: transparent;
    border: 0;
    border-bottom: 3px solid transparent;
    cursor: pointer;
  }
  .tab:hover { color: var(--white-10); }
  .tab[aria-selected='true'] { color: var(--white-10); border-bottom-color: var(--green-10); }
  .tab:focus-visible { outline: 2px solid var(--green-10); outline-offset: -2px; }
  .pen {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-bottom: var(--space-1);
    padding: var(--space-1) var(--space-3);
    min-height: 32px;
    font: inherit;
    font-size: 13px;
    font-weight: 600;
    color: var(--white-10);
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 6px;
    cursor: pointer;
  }
  .pen:hover { background: rgba(255, 255, 255, 0.14); }
  .pen:focus-visible { outline: 2px solid var(--green-10); outline-offset: 2px; }
  .pen i { font-size: 16px; }

  .panel[hidden] { display: none; }
  .preview { padding: var(--space-4); }
  .code { position: relative; background: var(--black-40); color: var(--white-10); }
  .code pre { margin: 0; padding: var(--space-4); padding-top: var(--space-10); max-height: 560px; overflow: auto; font-size: 13px; line-height: 1.55; tab-size: 2; }
  .code code { font-family: ui-monospace, Consolas, monospace; font-size: inherit; }
  .copy-btn {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 30px;
    padding: 2px var(--space-3);
    font: inherit;
    font-size: 13px;
    font-weight: 600;
    color: var(--white-10);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 6px;
  }
  .copy-btn i { font-size: 16px; }
  .copy-btn:hover { background: rgba(255, 255, 255, 0.18); }
</style>

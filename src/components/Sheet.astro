---
interface Props {
  /** Phosphor icon name, e.g. "palette". */
  icon: string;
  title: string;
  id?: string;
  /** Show the "click to copy" hint above the content. */
  hint?: boolean;
}
const { icon, title, id, hint = false } = Astro.props;
---

<section class="sheet" id={id} aria-labelledby={id ? `${id}-title` : undefined}>
  <header class="head">
    <div class="container inner">
      <h2 class="title" id={id ? `${id}-title` : undefined}>
        <i class={`ph-duotone ph-${icon}`} aria-hidden="true"></i>
        {title}
      </h2>
    </div>
  </header>
  <div class="container body">
    {
      hint && (
        <p class="hint">
          <i class="ph-duotone ph-copy" aria-hidden="true" />
          Click a card to copy its CSS.
        </p>
      )
    }
    <slot />
  </div>
</section>

<style>
  .sheet {
    color: var(--black-50);
    font-family: var(--font-display);
  }
  .sheet + .sheet { margin-top: var(--space-6); }
  .inner { display: flex; align-items: center; min-height: clamp(56px, 4.2vw, 80px); }
  .title {
    display: flex;
    align-items: center;
    gap: clamp(var(--space-3), 1.1vw, 20px);
    font-size: clamp(20px, 1.9vw, 32px);
    font-weight: 400;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-shadow: 0 4px 8px rgba(2, 27, 39, 0.1), 0 10px 17px rgba(2, 27, 39, 0.1);
  }
  .title i { font-size: 1.35em; }
  .body { padding-block: var(--space-2) clamp(var(--space-4), 2vw, 32px); }
  .hint {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    font-size: 14px;
    color: var(--black-20);
  }
  .hint i { font-size: 18px; }
</style>

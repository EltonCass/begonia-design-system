---
const base = import.meta.env.BASE_URL;
---

<footer class="footer">
  <div class="container inner">
    <p class="t-b2">Begonia style guide. Color, type, spacing, shadows, borders and icons.</p>
    <p class="t-label muted">
      Icons by <a href="https://phosphoricons.com/">Phosphor</a> (duotone). Fonts: Open Sans, Mosk, Roboto.
      &nbsp;<a href={base}>Back to the cover</a>.
    </p>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-24);
    padding-block: var(--space-8);
    background: var(--surface-header);
    border-top: 1px solid var(--card-border);
  }
  .inner { display: grid; gap: var(--space-2); }
</style>

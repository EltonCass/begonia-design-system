---
import Logo from './Logo.astro';
import { tabs } from '../lib/nav';

const base = import.meta.env.BASE_URL;
const here = Astro.url.pathname;
---

<header class="header" transition:persist>
  <div class="container bar">
    <a class="home" href={base} aria-label="Begonia style guide, home">
      <Logo size="40px" eager />
      <span class="name">Begonia</span>
      <span class="badge">v1.0</span>
    </a>

    <button class="menu-btn" id="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Menu">
      <i class="ph-duotone ph-list" aria-hidden="true"></i>
    </button>

    <nav id="site-nav" class="nav" aria-label="Main">
      {
        tabs.map((t) => {
          const href = `${base}${t.href}`;
          return (
            <a href={href} aria-current={here === href ? 'page' : undefined}>
              <i class={`ph-duotone ph-${t.icon}`} aria-hidden="true" />
              {t.label}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>

<script>
  // The header persists between pages, so keep its state in sync on every navigation.
  document.addEventListener('astro:page-load', () => {
    const menuBtn = document.getElementById('menu-btn')!;
    const nav = document.getElementById('site-nav')!;

    nav.querySelectorAll<HTMLAnchorElement>('a').forEach((a) => {
      if (new URL(a.href).pathname === location.pathname) a.setAttribute('aria-current', 'page');
      else a.removeAttribute('aria-current');
    });
    menuBtn.setAttribute('aria-expanded', 'false');
    nav.dataset.open = 'false';

    if (!menuBtn.dataset.bound) {
      menuBtn.dataset.bound = 'true';
      menuBtn.addEventListener('click', () => {
        const open = menuBtn.getAttribute('aria-expanded') === 'true';
        menuBtn.setAttribute('aria-expanded', String(!open));
        nav.dataset.open = String(!open);
      });
    }
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--surface-header);
    border-bottom: 1px solid var(--card-border);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    min-height: 72px;
    flex-wrap: wrap;
  }
  .home { display: flex; align-items: center; gap: var(--space-3); text-decoration: none; }
  .name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 24px;
    letter-spacing: -0.01em;
    background: var(--gradient-name-dark);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .badge {
    padding: 2px 10px;
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.5;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 999px;
  }

  .nav { display: flex; align-items: center; }
  .nav a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    color: var(--text);
    font-family: var(--font-display);
    font-size: 16px;
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: color 100ms, background-color 100ms;
  }
  .nav a i { font-size: 22px; color: var(--icon); transition: color 100ms; }
  /* Thin rule between tabs. */
  .nav a + a { position: relative; margin-left: var(--space-4); }
  .nav a + a::before {
    content: '';
    position: absolute;
    left: calc(var(--space-4) * -0.5 - 1px);
    top: 20%;
    bottom: 20%;
    width: 1px;
    background: var(--card-border);
  }
  .nav a:hover, .nav a:hover i { color: var(--accent); }
  .nav a[aria-current='page'] { color: var(--accent); background: var(--card-bg); }
  .nav a[aria-current='page'] i { color: var(--accent); }

  .menu-btn {
    display: none;
    place-items: center;
    width: 44px;
    height: 44px;
    font-size: 28px;
    color: var(--icon);
    background: transparent;
    border: 0;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }
  .menu-btn:hover { color: var(--accent); }

  @media (max-width: 1240px) {
    .menu-btn { display: grid; }
    .nav {
      display: none;
      flex-basis: 100%;
      flex-direction: column;
      align-items: stretch;
      padding-bottom: var(--space-4);
    }
    .nav[data-open='true'] { display: flex; }
    .nav a { padding-block: var(--space-3); }
    .nav a + a { margin-left: 0; margin-top: var(--space-1); }
    .nav a + a::before { left: var(--space-4); right: var(--space-4); top: calc(var(--space-1) * -0.5 - 1px); bottom: auto; width: auto; height: 1px; }
  }
</style>

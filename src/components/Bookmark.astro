---
interface Props {
  href: string;
  title: string;
  /** The domain shown under the description. */
  site: string;
  description: string;
  /** URL of the logo shown on the thumbnail. */
  logo: string;
  /** URL of the mesh gradient behind the logo. */
  mesh: string;
}
const { href, title, site, description, logo, mesh } = Astro.props;
---

<!-- Begonia's Bookmark: a link as a card (card-bg, 2px card-border, 16:9 thumbnail on the right from 640px). -->
<div class="bm">
<a class="bookmark" href={href} target="_blank" rel="noopener noreferrer">
  <span class="body">
    <h3 class="title">{title}</h3>
    <span class="desc">{description}</span>
    <span class="site">
      <i class="ph-duotone ph-arrow-up-right" aria-hidden="true"></i>{site}
      <span class="visually-hidden">(opens in a new tab)</span>
    </span>
  </span>
  <span class="thumb" style={`background-image: url(${mesh})`}>
    <img src={logo} alt="" width="56" height="56" />
  </span>
</a>
</div>

<style>
  .bm { container-type: inline-size; }
  .bookmark {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(180px, 34%, 300px);
    min-height: 124px;
    overflow: hidden;
    color: var(--text);
    text-decoration: none;
    background: var(--card-bg);
    border: 2px solid var(--card-border);
    border-radius: var(--radius-md);
    transition: border-color 100ms;
  }
  .bookmark:hover { border-color: var(--card-border-hover); }
  .body { display: grid; align-content: center; gap: var(--space-2); padding: var(--space-4) var(--space-5); min-width: 0; }
  .title {
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.25;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }
  .desc {
    font-size: 14px;
    font-weight: 300;
    line-height: 1.4;
    color: var(--text-muted);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }
  .site { display: inline-flex; align-items: center; gap: 4px; font-size: 12px; font-weight: 600; color: var(--text); }
  .site i { font-size: 16px; color: var(--accent); }
  .thumb {
    display: grid;
    place-items: center;
    background-size: cover;
    background-position: center;
    border-left: 2px solid var(--card-border);
    aspect-ratio: 16 / 9;
    align-self: stretch;
  }
  .thumb img { width: 56px; height: 56px; object-fit: contain; filter: drop-shadow(0 4px 8px rgba(2, 27, 39, 0.25)); }

  /* Phones: the thumbnail moves above the text. */
  @container (max-width: 640px) {
    .bookmark { grid-template-columns: minmax(0, 1fr); }
    .thumb { order: -1; width: 100%; border-left: 0; border-bottom: 2px solid var(--card-border); }
  }
</style>

---
import Layout from '../layouts/Layout.astro';
import Sheet from '../components/Sheet.astro';
import CodeView from '../components/CodeView.astro';
import { spacingDemo } from '../lib/snippets';

// The Figma sheet lists the standard rem scale (step n = n x 4px, plus a 1px step).
const steps = ['0', '0.1', '0.5', '1', '1.5', '2', '2.5', '3', '4', '5', '6', '7', '8', '9', '10', '12', '14', '16', '20', '24', '28', '32'].map(
  (name) => {
    const px = name === '0.1' ? 1 : Number(name) * 4;
    const rem = px === 1 || px === 0 ? `${px}px` : `${px / 16}rem`;
    return { name, rem, px };
  },
);

const demo = spacingDemo();
---

<Layout title="Spacing">
  <h1 class="visually-hidden">Spacing</h1>
  <div class="canvas">
    <Sheet id="spacing" icon="table" title="Spacing" hint>
      <div class="layout">
        <div class="scale">
          <table>
            <caption class="visually-hidden">Spacing scale: name, size in rem and size in pixels. Select a row to copy its CSS.</caption>
            <thead>
              <tr><th scope="col">Name</th><th scope="col">Size</th><th scope="col">Pixels</th><th scope="col"><span class="visually-hidden">Preview</span></th></tr>
            </thead>
            <tbody>
              {steps.map((s) => (
                <tr class="copyable" title="Click to copy CSS" data-copy={`--space-${s.name.replace('.', '_')}: ${s.rem}; /* ${s.px}px */`}>
                  <td><button type="button" class="rowbtn" aria-label={`Copy spacing ${s.name}, ${s.px} pixels`}>{s.name}</button></td>
                  <td>{s.rem}</td>
                  <td>{s.px}px</td>
                  <td class="barcell">{s.px > 0 && <span class="bar" aria-hidden="true" style={`width: ${s.px}px`}></span>}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="note t-label">
            The Begonia blog overrides the two smallest steps: <code>space-1</code> is 2px and <code>space-1.5</code> is
            4px. The semantic spacing tokens are listed in <code>tokens.json</code>.
          </p>
        </div>

        <div class="demo-wrap">
          <h3 class="demo-title"><i class="ph-duotone ph-presentation-chart" aria-hidden="true"></i>Demonstration</h3>
          <CodeView id="spacing-demo" title="Spacing demonstration" html={demo.html} css={demo.css}>
            <div class="preview-box cv-demo">
              <style is:inline set:html={demo.previewCss} />
              <Fragment set:html={demo.previewHtml} />
            </div>
          </CodeView>
        </div>
      </div>
    </Sheet>
  </div>
</Layout>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(300px, 580px) minmax(0, 1fr);
    gap: clamp(var(--space-6), 3vw, 64px);
    align-items: start;
  }
  .scale {
    padding: var(--space-4) var(--space-6);
    background: var(--white-10);
    border-radius: 8px;
    box-shadow: var(--shadow-md);
  }
  table { width: 100%; border-collapse: collapse; font-family: 'Roboto', sans-serif; font-size: 15px; }
  th { text-align: left; font-weight: 500; padding: var(--space-3) var(--space-3) var(--space-3) 0; }
  td { padding: 10px 12px 10px 0; border-top: 1px solid var(--black-10); }
  tbody tr:hover { background: var(--blue-10); }
  .rowbtn { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; }
  tbody tr:first-child td { border-top-color: var(--black-30); }
  th:first-child, td:first-child { width: 22%; }
  .barcell { width: 100%; padding-right: 0; }
  .bar { display: block; height: 14px; background: var(--mblue-40); max-width: 100%; }
  .note { margin-top: var(--space-4); color: var(--black-20); }
  code { font-family: ui-monospace, Consolas, monospace; }

  .demo-title { display: flex; align-items: center; gap: var(--space-3); font-size: 22px; font-weight: 400; text-transform: uppercase; margin-bottom: var(--space-4); }
  .demo-title i { font-size: 30px; }

  .preview-box { font-family: var(--font-display); }

  @media (max-width: 1000px) {
    .layout { grid-template-columns: minmax(0, 1fr); }
  }
  /* Narrow phones: shrink the whole demo so 64px stays 64px relative to its content. */
  @media (max-width: 640px) {
    .cv-demo :global(.demo) { zoom: 0.6; }
    .scale { padding-inline: var(--space-3); }
  }
</style>

---
import Layout from '../layouts/Layout.astro';
import Sheet from '../components/Sheet.astro';
import CodeView from '../components/CodeView.astro';
import { useExample } from '../lib/snippets';

const offsets = [8, 32, 16];
const examples = [16, 32].map((n) => ({ n, ...useExample(n) }));
const grids = [4, 8, 16, 32];

const gridCss = (n: number) =>
  `background-image: linear-gradient(rgba(35, 148, 183, 0.35) 1px, transparent 1px), linear-gradient(90deg, rgba(35, 148, 183, 0.35) 1px, transparent 1px);\nbackground-size: ${n}px ${n}px;`;
const offsetCss = (n: number) =>
  `display: grid;\ngrid-auto-columns: ${n}px;\ngrid-auto-rows: ${n}px;\ngap: ${n}px;\npadding: ${n}px;`;
---

<Layout title="Layouts">
  <h1 class="visually-hidden">Layouts</h1>
  <div class="canvas">
    <Sheet id="layouts" icon="layout" title="Layouts" hint>
      <div class="board">
        {
          offsets.map((n) => (
            <section class="spec" style={`--n: ${n}px`}>
              <h3><i class="ph-duotone ph-squares-four" aria-hidden="true"></i>Offset {n} / Auto Column {n} width / Auto Row {n} height</h3>
              <div class="frame offset copyable" role="button" tabindex="0" title="Click to copy CSS" data-copy={offsetCss(n)} aria-label={`Copy CSS for a ${n}px offset layout`}></div>
            </section>
          ))
        }

        <div class="pair">
          {
            grids.slice(0, 2).map((n) => (
              <section class="spec" style={`--n: ${n}px`}>
                <h3><i class={`ph-duotone ph-number-circle-${n === 4 ? 'four' : 'eight'}`} aria-hidden="true"></i>Grid {n}</h3>
                <div class="frame grid copyable" role="button" tabindex="0" title="Click to copy CSS" data-copy={gridCss(n)} aria-label={`Copy CSS for a ${n}px grid`}></div>
              </section>
            ))
          }
        </div>

        {
          grids.slice(2).map((n) => (
            <section class="spec" style={`--n: ${n}px`}>
              <h3><i class="ph-duotone ph-squares-four" aria-hidden="true"></i>Grid {n}</h3>
              <div class="frame grid copyable" role="button" tabindex="0" title="Click to copy CSS" data-copy={gridCss(n)} aria-label={`Copy CSS for a ${n}px grid`}></div>
            </section>
          ))
        }

        {
          examples.map((ex) => (
            <section class="spec">
              <h3><i class="ph-duotone ph-user-circle" aria-hidden="true"></i>Use</h3>
              <p class="use-spec">Offset {ex.n} / Auto Column {ex.n} width / Auto Row {ex.n} height</p>
              <CodeView id={`use-${ex.n}`} title={`Use: offset ${ex.n}`} html={ex.html} css={ex.css}>
                <div class={`preview-box cv-use-${ex.n}`}>
                  <style is:inline set:html={ex.previewCss} />
                  <Fragment set:html={ex.previewHtml} />
                </div>
              </CodeView>
            </section>
          ))
        }
      </div>
    </Sheet>
  </div>
</Layout>

<style>
  .board {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-8) clamp(var(--space-6), 6vw, 110px);
  }
  .pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-6); }
  .spec h3 {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    font-size: clamp(16px, 1.3vw, 22px);
    font-weight: 600;
  }
  .spec h3 i { font-size: 24px; flex: none; }

  /* The Figma frames are layout grids: lines every N px, drawn here so they can be seen. */
  .frame {
    height: clamp(220px, 28vw, 440px);
    border: 1px solid var(--bsapphire-30);
    border-radius: 4px;
    background-color: var(--white-10);
    --line: rgba(35, 148, 183, 0.35);
  }
  .grid {
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: var(--n) var(--n);
  }
  .offset {
    background-image: repeating-linear-gradient(90deg, rgba(235, 107, 109, 0.22) 0 var(--n), transparent var(--n) calc(var(--n) * 2));
    background-size: 100% 100%;
  }

  .use-spec { margin: calc(var(--space-2) * -1) 0 var(--space-3); font-size: 14px; color: var(--black-20); }
  /* The preview runs the CSS shown in the CSS tab; this only sets the page-level font and color the tab's body rule sets. */
  .preview-box { font-family: var(--font-display); color: var(--black-50); }

  @media (max-width: 900px) {
    .board { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 560px) {
  }
</style>

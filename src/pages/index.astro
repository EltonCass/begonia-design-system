---
import Layout from '../layouts/Layout.astro';
import ColorCard from '../components/ColorCard.astro';
import Logo from '../components/Logo.astro';

const base = import.meta.env.BASE_URL;

// Twelve cards in three columns, like the Figma cover backdrop.
const backdrop = [
  ['red', 'blue', 'mbrown', 'bsapphire'],
  ['dwhite', 'mblue', 'dlavender', 'green'],
  ['gray', 'black', 'white', 'red'],
];

const sections = [
  { href: 'color/', icon: 'palette', title: 'Color', text: 'Eleven nine-step palettes, alphas and named gradients.' },
  { href: 'typography/', icon: 'pen-nib', title: 'Typography', text: 'Open Sans and Mosk, with heading and content sizes.' },
  { href: 'spacing/', icon: 'table', title: 'Spacing', text: 'The spacing scale and how it measures out a page.' },
  { href: 'brand/', icon: 'person-simple', title: 'Brand', text: 'The begonia logo and the brand logos, with SVG and PNG downloads.' },
  { href: 'shadows-borders/', icon: 'intersect', title: 'Shadows & borders', text: 'Drop, inner and color shadows. One-side and full borders.' },
  { href: 'layouts/', icon: 'layout', title: 'Layouts', text: 'Offsets and square grids, and a layout in use.' },
  { href: 'iconography/', icon: 'image-square', title: 'Iconography', text: 'The Phosphor duotone icon set, grouped by category.' },
  { href: 'how-to-use/', icon: 'rocket-launch', title: 'How to use', text: 'The Figma file, the GitHub repo, the Claude artifact and a quick start.' },
];
---

<Layout title="Begonia" tone="dark">
  <section class="hero" aria-labelledby="cover-title">
    <div class="backdrop" aria-hidden="true" inert>
      {
        backdrop.map((col) => (
          <div class="col">
            {col.map((family) => (
              <div class="cell">
                <ColorCard family={family} />
              </div>
            ))}
          </div>
        ))
      }
    </div>
    <div class="overlay"></div>

    <div class="content">
      <h1 id="cover-title" class="title">
        <span>“BEGONIA”</span>
        <span>STYLE GUIDE</span>
      </h1>
      <Logo size="var(--logo)" eager alt="Begonia logo: a pink begonia flower inside a teal circle" />
    </div>
  </section>

  <section class="container index" aria-labelledby="sections-title">
    <h2 id="sections-title" class="visually-hidden">Sections</h2>
    <ul class="cards">
      {
        sections.map((s) => (
          <li>
            <a class="card" href={`${base}${s.href}`}>
              <i class={`ph-duotone ph-${s.icon}`} aria-hidden="true"></i>
              <h3 class="t-h3 card-title">{s.title}</h3>
              <span class="t-b2 muted">{s.text}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <footer class="container credit">
    <p>
      Designed and developed by{' '}
      <a href="https://github.com/EltonCass" target="_blank" rel="noopener noreferrer">Elton Cassas<span class="visually-hidden"> (opens in a new tab)</span></a>.
    </p>
  </footer>
</Layout>

<style>
  .hero {
    --logo: clamp(200px, 21.2vw, 407px);
    position: relative;
    overflow: hidden;
    background: var(--black-40);
    isolation: isolate;
  }
  .backdrop {
    position: absolute;
    z-index: -2;
    top: 50%;
    left: 50%;
    display: flex;
    gap: 44px;
    width: 3170px;
    padding: 80px 64px;
    transform: translate(-50%, -50%) rotate(-15deg);
    pointer-events: none;
  }
  .col { display: grid; gap: 40px; align-content: start; }
  .cell { width: 898px; }
  .overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgba(2, 27, 39, 0.92);
  }
  .content {
    display: grid;
    justify-items: center;
    gap: clamp(var(--space-4), 1.7vw, 32px);
    padding-block: clamp(var(--space-10), 5.6vw, 108px);
  }
  .title {
    display: grid;
    text-align: center;
    color: var(--white-30);
    font-family: Mosk, var(--font-sans);
    font-weight: 700;
    font-size: clamp(2.75rem, 5vw, 6rem);
    line-height: 1.5;
    text-shadow: 0 4px 8px rgba(2, 27, 39, 0.1), 0 10px 17px rgba(2, 27, 39, 0.1);
  }

  .index { margin-top: var(--space-16); }
  .credit { padding-block: var(--space-12) var(--space-10); }
  .credit p { font-size: 14px; color: var(--text-muted); }
  .credit a { color: var(--accent); font-weight: 600; }
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-6);
  }
  .card {
    display: grid;
    gap: var(--space-2);
    height: 100%;
    padding: var(--space-6);
    background: var(--card-bg);
    border: 2px solid var(--card-border);
    border-radius: var(--radius-md);
    color: var(--text);
    text-decoration: none;
    transition: border-color 100ms;
  }
  .card:hover { border-color: var(--card-border-hover); }
  .card-title { font-weight: 400; }
  .card i { font-size: 32px; color: var(--icon); }
  .card:hover i { color: var(--accent); }
</style>

---
import Layout from '../layouts/Layout.astro';
import Sheet from '../components/Sheet.astro';
import { peep } from '../lib/copy';

const openSans = [
  { name: 'Open Sans', weight: 'Regular', css: 'font-family: var(--font-display); font-weight: 400' },
  { name: 'Open Sans', weight: 'Semibold', css: 'font-family: var(--font-display); font-weight: 600' },
];
const mosk = [
  { name: 'Mosk', weight: 'Light', css: 'font-family: Mosk; font-weight: 300' },
  { name: 'Mosk', weight: 'Medium', css: 'font-family: Mosk; font-weight: 500' },
  { name: 'Mosk', weight: 'Thin', css: 'font-family: Mosk; font-weight: 100' },
  { name: 'Mosk', weight: 'Semi Bold', css: 'font-family: Mosk; font-weight: 600' },
];
const headings = ['h1', 'h2', 'h3', 'h4', 'h5'];
---

<Layout title="Typography">
  <h1 class="visually-hidden">Typography</h1>
  <div class="canvas">
    <Sheet id="font-families" icon="pen-nib" title="Font families" rule="var(--blue-70)">
      <div class="families">
        <div class="family">
          <div class="intro">
            <h3>OPEN SANS</h3>
            <p class="t-b2">
              Open Sans was designed with an upright stress, open forms and a neutral, yet friendly appearance. It was
              optimized for print, web, and mobile interfaces, and has excellent legibility characteristics in its
              letterforms.
            </p>
          </div>
          <ul class="specimens">
            {openSans.map((s) => (
              <li class="specimen">
                <div class="tag"><span class="fam" style={s.css}>{s.name}</span><span class="wt">{s.weight}</span></div>
                <p class="sample" style={`${s.css}; font-size: 14px; line-height: 1.3`}>{peep}</p>
              </li>
            ))}
          </ul>
        </div>

        <div class="family">
          <div class="intro">
            <h3>MOSK</h3>
            <p class="t-b2">
              Mosk Font is a sans-serif typeface family designed by Russian type designer Maria Doreuli. The fonts come in
              six weights–light, regular, medium, bold, black and extra black–each with matching italics. Mosk Typeface
              was inspired by the classic grotesque typefaces of the late 19th and early 20th centuries but has a more
              contemporary feel.
            </p>
          </div>
          <ul class="specimens">
            {mosk.map((s) => (
              <li class="specimen">
                <div class="tag"><span class="fam" style={s.css}>{s.name}</span><span class="wt" style={s.css}>{s.weight}</span></div>
                <p class="sample" style={`${s.css}; font-size: 14px; line-height: 1.3`}>{peep}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </Sheet>

    <Sheet id="font-sizes" icon="pen-nib" title="Font sizes" rule="var(--blue-70)">
      <div class="sizes">
        <section>
          <h3 class="col-title"><i class="ph-duotone ph-text-h-one" aria-hidden="true"></i>Headings</h3>
          {headings.map((h, i) => (
            <div class="item">
              <p class="item-label">Heading {i + 1} / {h}</p>
              <div class="demo">
                <p class={`t-${h} up`}>This is an example</p>
                <p class={`t-${h}`}>This is an example</p>
              </div>
            </div>
          ))}
        </section>

        <section>
          <h3 class="col-title"><i class="ph-duotone ph-text-t" aria-hidden="true"></i>Content</h3>
          <div class="item"><p class="item-label">Subtitle 1 / s1</p><p class="demo t-s1">{peep} BRAIN BITES</p></div>
          <div class="item"><p class="item-label">Subtitle 2 / s2</p><p class="demo t-s2">{peep}</p></div>
          <div class="item"><p class="item-label">Body 1 / b1</p><p class="demo t-b1">{peep}</p></div>
          <div class="item"><p class="item-label">Body 2 / b2 /span</p><p class="demo t-b2">{peep}</p></div>
          <div class="item"><p class="item-label">Anchor a</p><p class="demo t-b2 anchor">{peep}</p></div>
          <div class="item"><p class="item-label">Content Italic</p><p class="demo t-content-italic">{peep}</p></div>
          <div class="item"><p class="item-label">PlaceHolder</p><p class="demo t-label placeholder">{peep}</p></div>
        </section>

        <section>
          <h3 class="col-title"><i class="ph-duotone ph-user-circle" aria-hidden="true"></i>Basic Use</h3>
          <article class="use">
            <h4 class="use-title">Importance of Typography</h4>
            <p class="t-s1">
              Typography is a crucial element of design that can make or break the success of a project. It involves the
              art and technique of arranging type in a way that is not only visually appealing but also easy to read and
              understand. Good typography has the power to convey emotions, establish hierarchy, and enhance the overall
              user experience.
            </p>
            <p class="t-b2">
              One of the key benefits of typography is its ability to communicate information effectively. Choosing the
              right typeface, font size, and spacing can significantly impact how a message is perceived by the reader. A
              well-designed typographic layout can draw the reader's attention to important information and make it
              easier for them to navigate through the content.
            </p>
            <p class="t-b2">
              Typography can also play a significant role in creating a brand identity. A distinctive typeface can make a
              brand recognizable and memorable, and help it stand out from the competition. For example, the Coca-Cola
              logo is instantly recognizable thanks to its unique script font.
            </p>
            <p class="t-b2">
              In addition to aesthetics, typography also plays a vital role in accessibility. Choosing a legible typeface
              and adjusting the size, weight, and spacing can make content more accessible to people with visual
              impairments or reading difficulties.
            </p>
            <p class="t-b1">
              In conclusion, typography is an essential element of design that should not be overlooked. It can impact the
              readability, effectiveness, and overall impression of a project. By taking the time to carefully select and
              arrange type, designers can create designs that are not only visually appealing but also functional and
              accessible.
            </p>
            <p class="t-label placeholder">Generated by AI</p>
          </article>
        </section>
      </div>
    </Sheet>
  </div>
</Layout>

<style>
  .families { display: grid; gap: var(--space-10); }
  .family {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 8fr);
    gap: var(--space-8) clamp(var(--space-6), 3vw, 48px);
    align-items: start;
  }
  .intro h3 { font-size: 22px; font-weight: 400; margin-bottom: var(--space-4); }
  .intro p { padding-left: var(--space-8); line-height: 1.4; font-family: Mosk; font-size: 14px; }

  .specimens {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5) clamp(var(--space-4), 2.2vw, 40px);
  }
  .specimen {
    display: grid;
    grid-template-columns: minmax(96px, 28%) 1fr;
    border: 1px solid var(--black-30);
    border-radius: 8px;
    overflow: hidden;
    min-height: 94px;
  }
  .tag {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: var(--space-4);
    padding: var(--space-3);
    background: var(--mblue-90);
    color: var(--white-10);
    text-align: center;
  }
  .fam { font-size: 17px; }
  .wt { font-size: 12px; font-family: var(--font-display); }
  .sample { align-self: center; padding: var(--space-3) var(--space-4); }

  .sizes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-10) clamp(var(--space-6), 3vw, 56px); }
  .col-title { display: flex; align-items: center; gap: var(--space-3); font-size: 22px; font-weight: 400; margin-bottom: var(--space-6); }
  .col-title i { font-size: 30px; }
  .item { margin-bottom: var(--space-5); }
  .item-label { font-size: 20px; line-height: 1.3; margin-bottom: var(--space-3); }
  .demo { text-align: center; color: var(--black-30); display: grid; gap: var(--space-2); }
  .up { text-transform: uppercase; }
  .anchor { color: var(--blue-70); }
  .placeholder { color: var(--gray-40); }
  .use { display: grid; gap: var(--space-3); padding-left: var(--space-2); color: var(--black-30); }
  .use-title { font-size: 22px; font-weight: 400; color: var(--black-20); margin-bottom: var(--space-2); }

  @media (max-width: 1100px) {
    .sizes { grid-template-columns: minmax(0, 1fr); }
    .family { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 640px) {
    .specimens { grid-template-columns: minmax(0, 1fr); }
    .intro p { padding-left: 0; }
  }
</style>

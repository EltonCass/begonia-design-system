---
import Layout from '../layouts/Layout.astro';
import Sheet from '../components/Sheet.astro';
import Bookmark from '../components/Bookmark.astro';
import Logo from '../components/Logo.astro';
import tokens from '../data/tokens.json';
import { tok } from '../lib/css';
import { svgAsset } from '../lib/assets';

const base = import.meta.env.BASE_URL;

const figma = svgAsset('logos', 'figma');
const github = svgAsset('logos', 'github');
const claude = svgAsset('logos', 'claude');

// Each bookmark sits on a different mesh gradient, as Begonia's Bookmark does when a page has no image.
const bookmarks = [
  {
    href: 'https://www.figma.com/community/file/1231390020444406234/begonia-style-guide',
    title: 'Begonia Style Guide (Community) · Figma',
    site: 'figma.com',
    description: 'The source design. Inspect the frames, colors and text styles, or duplicate the file into your own drafts.',
    logo: figma.url,
    mesh: svgAsset('meshes', 'mesh-purple-sapphire').url,
  },
  {
    href: 'https://github.com/EltonCass/begonia-design-system',
    title: 'EltonCass/begonia-design-system · GitHub',
    site: 'github.com',
    description: 'The code for this site: Astro pages, the tokens file and the GitHub Pages workflow.',
    logo: github.url,
    mesh: svgAsset('meshes', 'mesh-blue-green').url,
  },
  {
    href: 'https://claude.ai/artifact/DB8oxkPVmgqjuntzTZ34HG',
    title: 'Begonia design system · Claude',
    site: 'claude.ai',
    description: 'The system as a Claude artifact: tokens, the brand book and components. Open it in Claude to design with Begonia.',
    logo: claude.url,
    mesh: svgAsset('meshes', 'mesh-green-purple').url,
  },
];

// Semantic tokens for both themes, resolved from tokens.json so the snippet never drifts.
const semantic = ['bg', 'text', 'text-muted', 'accent', 'card-bg', 'card-border'];
const resolve = (value: string) => (value.startsWith('{') ? tok(value.slice(1, -1)) : value);
const themeVars = (theme: 'dark' | 'light') =>
  semantic
    .map((name) => {
      const t = tokens.color.tokens.find((x) => x.name === name)!;
      const v = t.value as Record<string, string>;
      return `  --${name}: ${resolve(v[theme])};`;
    })
    .join('\n');

const snippets = {
  head: `<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&display=swap">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/duotone/style.css">`,
  tokens: `:root {\n${themeVars('dark')}\n}\n\n:root[data-theme='light'] {\n${themeVars('light')}\n}`,
  base: `body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: "Mosk", "Open Sans", sans-serif;
  font-size: 16px;
  line-height: 1.5;
}

h1, h2 { font-family: "Open Sans", sans-serif; font-weight: 600; }

/* Phosphor's back layer is 20%; Begonia uses 25%. */
.ph-duotone::before { opacity: 0.25; }`,
};

const flow = [
  { name: 'Figma file', text: 'The source of the design.' },
  { name: 'Claude artifact', text: 'Keeps the tokens, the brand book and components.' },
  { name: 'This site', text: 'Documents the tokens and copies them as CSS.' },
];
---

<Layout title="How to use">
  <h1 class="visually-hidden">How to use</h1>
  <div class="canvas">
    <Sheet id="resources" icon="rocket-launch" title="Resources">
      <div class="column" data-theme="light">
        <ul class="bookmarks">
          {bookmarks.map((b) => <li><Bookmark {...b} /></li>)}
        </ul>
      </div>
    </Sheet>

    <Sheet id="how" icon="book-open-text" title="Quick start">
      <ol class="steps column">
        <li>
          <h3>Load the fonts and icons</h3>
          <p>
            Open Sans and the Phosphor duotone icons load from a CDN. Mosk is not on Google Fonts: download it from the{' '}
            <a href={`${base}typography/`}>Typography page</a> and add it with <code>@font-face</code>.
          </p>
          <figure class="snippet">
            <figcaption>
              <span>HTML</span>
              <button type="button" class="copy-btn copyable" data-copy={snippets.head}>
                <i class="ph-duotone ph-copy" aria-hidden="true"></i>Copy<span class="visually-hidden"> HTML snippet</span>
              </button>
            </figcaption>
            <pre tabindex="0"><code>{snippets.head}</code></pre>
          </figure>
        </li>
        <li>
          <h3>Add the tokens</h3>
          <p>
            The semantic tokens below come from <code>tokens.json</code>, the same file this site is built from. Every card on
            the other pages copies its own value when you click it.
          </p>
          <figure class="snippet">
            <figcaption>
              <span>CSS</span>
              <button type="button" class="copy-btn copyable" data-copy={snippets.tokens}>
                <i class="ph-duotone ph-copy" aria-hidden="true"></i>Copy<span class="visually-hidden"> theme tokens</span>
              </button>
            </figcaption>
            <pre tabindex="0"><code>{snippets.tokens}</code></pre>
          </figure>
        </li>
        <li>
          <h3>Set the base styles</h3>
          <figure class="snippet">
            <figcaption>
              <span>CSS</span>
              <button type="button" class="copy-btn copyable" data-copy={snippets.base}>
                <i class="ph-duotone ph-copy" aria-hidden="true"></i>Copy<span class="visually-hidden"> base styles</span>
              </button>
            </figcaption>
            <pre tabindex="0"><code>{snippets.base}</code></pre>
          </figure>
        </li>
      </ol>
    </Sheet>

    <Sheet id="fit" icon="intersect" title="How the pieces fit">
      <div class="column">
        <ol class="flow">
          {
            flow.map((step, i) => (
              <li>
                <div class="node">
                  <span class="mark">
                    {i === 0 && <img src={figma.url} alt="" width="40" height="40" />}
                    {i === 1 && <img src={claude.url} alt="" width="40" height="40" />}
                    {i === 2 && <Logo size="44px" />}
                  </span>
                  <h3>{step.name}</h3>
                  <p>{step.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <p class="summary">
          Design in Figma, keep the values as tokens in the Claude artifact, then use this site to find a value and copy it
          straight into code.
        </p>
      </div>
    </Sheet>
  </div>
</Layout>

<style>
  .column { max-width: 960px; }
  .bookmarks { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-4); color: var(--text); }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-6); counter-reset: step; }
  .steps > li { counter-increment: step; display: grid; gap: var(--space-2); }
  .steps h3 { display: flex; align-items: center; gap: var(--space-3); font-size: 20px; font-weight: 600; }
  .steps h3::before {
    content: counter(step);
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    flex: none;
    font-size: 16px;
    color: var(--white-10);
    background: var(--black-50);
    border-radius: 50%;
  }
  .steps p { font-size: 16px; line-height: 1.5; color: var(--black-30); }
  .steps a { color: var(--blue-70); }
  code { font-family: ui-monospace, Consolas, monospace; font-size: 0.92em; }

  .snippet { margin: var(--space-2) 0 0; background: var(--black-40); color: var(--white-10); border-radius: 8px; overflow: hidden; }
  figcaption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-4);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    background: rgba(255, 255, 255, 0.08);
  }
  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    font-size: 14px;
    font-weight: 600;
    color: var(--white-10);
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 6px;
    min-height: 36px;
  }
  .copy-btn i { font-size: 18px; }
  .copy-btn:hover { background: rgba(255, 255, 255, 0.12); }
  pre { margin: 0; padding: var(--space-4); overflow-x: auto; font-size: 14px; line-height: 1.55; }
  pre code { font-size: inherit; }

  /* Three steps, each leading to the next. */
  .flow { list-style: none; margin: 0 0 var(--space-6); padding: 0; display: flex; align-items: stretch; gap: var(--space-4); }
  .flow > li { flex: 1 1 0; display: flex; align-items: center; gap: var(--space-4); min-width: 0; }
  .flow > li + li::before { content: '\2192' / ''; flex: none; font-size: 28px; line-height: 1; color: var(--black-20); }
  .node {
    flex: 1;
    display: grid;
    gap: var(--space-2);
    align-content: start;
    height: 100%;
    padding: var(--space-5);
    background: var(--white-10);
    border: 1px solid var(--black-30);
    border-radius: 12px;
    min-width: 0;
  }
  .mark { display: grid; place-items: center; width: 56px; height: 56px; margin-bottom: var(--space-1); background: var(--white-50); border-radius: 12px; }
  .mark img { width: 36px; height: 36px; object-fit: contain; }
  .node h3 { font-size: 20px; font-weight: 600; }
  .node p { font-size: 15px; line-height: 1.45; color: var(--black-30); }
  .summary { max-width: 70ch; font-size: clamp(16px, 1.3vw, 19px); line-height: 1.55; color: var(--black-30); }

  @media (max-width: 800px) {
    .flow { flex-direction: column; gap: var(--space-3); }
    .flow > li { flex-direction: column; align-items: stretch; gap: var(--space-3); }
    .flow > li + li::before { content: '\2193' / ''; align-self: center; }
  }
</style>
